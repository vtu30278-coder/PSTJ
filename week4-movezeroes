class Solution {
    public void moveZeroes(int[] nums) {
        int b = 0;
        for(int a = 0;a < nums.length;a++){
            if(nums[a] != 0){
                int temp = nums[a];
                nums[a] = nums[b];
                nums[b] = temp;
                b++;
            }
        }
        
    }
}
